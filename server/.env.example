PORT=5000

# Leave empty to use an in-memory MongoDB (great for local demos).
# For a real database use e.g. mongodb://127.0.0.1:27017/shopvista
MONGODB_URI=

# Use a long, random value in production.
JWT_SECRET=change_me_to_a_long_random_string

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
